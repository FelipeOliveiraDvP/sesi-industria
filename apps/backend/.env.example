# Modelo de desenvolvimento para copiar para .env.
# ASP.NET Core não carrega .env automaticamente; no Bash, carregue-o explicitamente.
ConnectionStrings__DefaultConnection='Host=localhost;Port=5432;Database=catalog_db;Username=catalog_user;Password=catalog_dev_password'
FRONTEND_URL='http://127.0.0.1:5173'
# Opcional; mantenha false no desenvolvimento local. Habilite somente para a demo.
Database__InitializeOnStartup=false
